# Параметры датасета
DATASET_SLUG=inside_airbnb_barcelona
PRIMARY_FILE=listings.csv.gz

# URL источника (прямая ссылка на файл)
SOURCE_URL=https://data.insideairbnb.com/spain/catalonia/barcelona/2026-09-17/data/listings.csv.gz

# Подключение к SeaweedFS (S3-совместимое хранилище)
AIRFLOW_CONN_S3_CONN=aws://admin:admin@?endpoint_url=http://seaweedfs:8333

# Локальный порт для HTTP-сервера (fallback)
SOURCE_HTTP_PORT=8000
