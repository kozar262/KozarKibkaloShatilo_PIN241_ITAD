# Параметры датасета
DATASET_SLUG=inside_airbnb_barcelona
PRIMARY_FILE=listings.csv.gz

# URL источника
SOURCE_URL=https://data.insideairbnb.com/spain/catalonia/barcelona/2026-09-17/data/listings.csv.gz

# S3-подключение к SeaweedFS (используется в Airflow Connections, не напрямую)
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin

# Порт для локального HTTP-сервера (fallback)
SOURCE_HTTP_PORT=8000
